# macOS
.DS_Store

# Build artifacts of devtools/bbcode-preview.py, written beside its source.
# The --inline variant embeds every asset as a data: URI, so it is several
# megabytes of regenerable base64 — never commit it.
_bbcode-preview.html
_bbcode-preview-inline.html

# Re-minted by media/banner-export.sh on every run — template + title map.
media/cards/_export/

# Editor state
.vscode/

# Agent instructions are shared in AGENTS.md, which is vendor-neutral and
# checked in. Assistant-specific files import it and add whatever is local to
# one working copy, so they stay untracked.
CLAUDE.md
CLAUDE.local.md
.cursorrules
.cursor/
.github/copilot-instructions.md

# C# build output
obj/
bin/

# Python bytecode from the bridge drivers (py_compile checks drop these)
__pycache__/

# Harness scratch: the isolated save-data folder run-harness.sh creates.
dist/

# RimWorld's texture cache. The game never writes these itself, but tools on
# this machine do — and a .dds beside a PNG makes the game ignore the PNG
# entirely, with no timestamp check. This mod ships no textures today; the
# rule is here so it cannot start.
*.dds

# Hot-reload dev artifacts (ECR). Debug builds drop the reloader runtime, its
# dependencies and an instrumented-original copy beside our dll; the Release
# build sweeps them. Only our own assembly is ever tracked.
Assemblies/*
!Assemblies/ApparelPainter.dll
