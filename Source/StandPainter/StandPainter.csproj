<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stand Painter's only assembly. RimWorld is .NET Framework 4.7.2. Game
       references resolve below, either from a local install or from
       Krafs.Rimworld.Ref (same pattern as Shift Change and Fine
       Establishments). No Harmony: phase 1 patches nothing — the whole
       engine surface is a startup list injection and one reflection call. -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StandPainter</RootNamespace>
    <AssemblyName>StandPainter</AssemblyName>
    <Version>0.0.1</Version>
    <Configurations>Debug;Release</Configurations>

    <!-- Straight into the mod's load path, no framework subfolder, no pdb —
         the game cannot read one. -->
    <OutputPath>../../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- net472 reference assemblies, so this builds on a machine with only
         the modern dotnet SDK (this one is a Mac; there is no Framework
         targeting pack outside the package). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game references, two modes, one committed file (the shift-change
       pattern; its csproj carries the full story). A machine with a RimWorld
       install compiles against the REAL game assemblies in every
       configuration, so go-to-definition decompiles engine bodies; a machine
       without one (CI, a fresh clone) falls back to Krafs.Rimworld.Ref.
       To reproduce CI locally, pass -p:DisableLocalGameRefs=true.
       Non-standard install: set RimWorldManaged (env var or -p:). The
       Odyssey outfit-stand types need no extra reference — DLC types ship
       inside Assembly-CSharp. -->
  <PropertyGroup>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == '' AND Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app/Contents/Resources/Data/Managed')">$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app/Contents/Resources/Data/Managed</RimWorldManaged>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == '' AND Exists('$(HOME)/.steam/steam/steamapps/common/RimWorld/RimWorldLinux_Data/Managed')">$(HOME)/.steam/steam/steamapps/common/RimWorld/RimWorldLinux_Data/Managed</RimWorldManaged>
    <LocalGameRefs Condition="'$(RimWorldManaged)' != '' AND '$(DisableLocalGameRefs)' != 'true'">true</LocalGameRefs>
  </PropertyGroup>

  <ItemGroup Condition="'$(LocalGameRefs)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalGameRefs)' == 'true'">
    <!-- Private=false is this group's ExcludeAssets: compile-time only. -->
    <Reference Include="$(RimWorldManaged)/Assembly-CSharp.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RimWorldManaged)/UnityEngine.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RimWorldManaged)/UnityEngine.*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Hot reload (ECR, Zetrith's EditCompileReload) — DEV ONLY. Debug builds
       instrument the assembly and watch for recompiles, so a layout tweak
       shows in the running game without a restart; Release never references
       any of it. This mod is UI-heavy, so the rig earns its keep. The
       library must sit beside our dll at runtime, hence the Debug-only copy
       override (the global default is false because Assemblies/ must ship
       only our dll). -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="EditCompileReload" Version="1.0.2" />
    <PackageReference Include="EditCompileReload.CompilerPlugin" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Any non-Debug build is a choke point that sweeps dev artifacts out of
       the mod's load path — hygiene by construction, not by memory: whatever
       a Debug session dropped in (the ECR runtime, its dependencies, the
       instrumented-original copy), the next Release build removes, leaving
       exactly the one dll the mod ships. -->
  <Target Name="CleanDevArtifacts" AfterTargets="Build" Condition="'$(Configuration)' != 'Debug'">
    <ItemGroup>
      <DevJunk Include="$(OutputPath)*.dll" Exclude="$(OutputPath)$(AssemblyName).dll" />
      <DevJunk Include="$(OutputPath)*.dll_orig" />
      <DevJunk Include="$(OutputPath)*.pdb" />
    </ItemGroup>
    <Delete Files="@(DevJunk)" />
  </Target>

</Project>
